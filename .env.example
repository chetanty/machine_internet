# Set any ONE of these. If several are set, they are tried in this order
# and the next is used when one hits a quota or server error.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-2.0-flash-lite

# Credentials for the API you are wrapping, used by `machine-internet serve`
# MI_TOKEN=            bearer token
# MI_API_KEY=          API key (MI_API_KEY_NAME, MI_API_KEY_IN=header|query)
# MI_USERNAME= / MI_PASSWORD=
